{
  "name": "goods-manager-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node ../../tools/notices/verify-notices.mjs && tsc --noEmit && vite build && npm run build:ocr",
    "dev": "vite",
    "test": "node --test ../../tests/Browser/*.test.mjs",
    "build:ocr": "vite build --config vite.ocr.config.ts && node ../../tools/photo-ocr/prepare-assets.mjs"
  },
  "dependencies": {
    "@ericblade/quagga2": "1.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@techstark/opencv-js": "4.10.0-release.1",
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
