<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Samples/Assets/*" LogicalName="sample-data/%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- 生成アセットは発行直前に確定し、運用データと鍵を発行物へ混入させない。 -->
    <Content Remove="wwwroot/**/*;data/**/*" />
    <None Remove="data/**/*" />
    <Content Remove="PhotoOcrAssets/**/*" />
    <None Remove="PhotoOcrAssets/**/*" />
    <Content Remove="Samples/Assets/**/*" />
    <None Remove="Samples/Assets/**/*" />
    <Content Include="../../third-party/application/**/*" Link="notices/application/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildCollectionClient" AfterTargets="ComputeFilesToPublish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="../GoodsManager.Client" Command="npm ci --ignore-scripts" />
    <Exec WorkingDirectory="../GoodsManager.Client" Command="npm run build" />
    <ItemGroup>
      <_PublishedDependencies Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == '$(AssemblyName).deps.json'" />
    </ItemGroup>
    <Error Condition="'@(_PublishedDependencies->Count())' != '1'" Text="発行する依存情報を一意に取得できません。" />
    <Exec Command="node ../../tools/notices/verify-notices.mjs &quot;%(_PublishedDependencies.FullPath)&quot;" />
    <ItemGroup>
      <_ClientFiles Include="wwwroot/**/*" />
      <_OcrFiles Include="PhotoOcrAssets/**/*" />
      <ResolvedFileToPublish Include="@(_ClientFiles->'%(FullPath)')">
        <RelativePath>wwwroot/%(_ClientFiles.RecursiveDir)%(_ClientFiles.Filename)%(_ClientFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_OcrFiles->'%(FullPath)')">
        <RelativePath>PhotoOcrAssets/%(_OcrFiles.RecursiveDir)%(_OcrFiles.Filename)%(_OcrFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
