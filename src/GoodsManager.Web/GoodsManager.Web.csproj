<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Development/AuthCheck/*" />
    <EmbeddedResource Include="Development/MasterCheck/*" />
    <EmbeddedResource Include="Development/ProductCheck/*" />
    <EmbeddedResource Include="Development/ImageCheck/*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- 生成アセットは発行直前に確定し、運用データと鍵を発行物へ混入させない。 -->
    <Content Remove="wwwroot/**/*;data/**/*" />
    <None Remove="data/**/*" />
  </ItemGroup>
  <Target Name="BuildCollectionClient" AfterTargets="ComputeFilesToPublish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="../GoodsManager.Client" Command="npm ci --ignore-scripts" />
    <Exec WorkingDirectory="../GoodsManager.Client" Command="npm run build" />
    <ItemGroup>
      <_ClientFiles Include="wwwroot/**/*" />
      <ResolvedFileToPublish Include="@(_ClientFiles->'%(FullPath)')">
        <RelativePath>wwwroot/%(_ClientFiles.RecursiveDir)%(_ClientFiles.Filename)%(_ClientFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
